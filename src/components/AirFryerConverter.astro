---
// Oven → air fryer converter for one dish. The result updates as the
// user types; the initial answer from the dish's typical oven settings
// is server-rendered so the page still answers without JavaScript (the
// reference table below does too). The form also has an explicit
// Convert submit button (MWG forms: every form gets a submit button
// with actionable language). It runs the same conversion the live
// updates perform; it never navigates anywhere. Because the live
// updates already computed the answer, a Convert click would look dead
// without visible feedback (Cozy, 2026-11-20), so the submit handler
// flashes the result and moves focus to it.
//
// The rule: air fryer temp = oven temp minus 25F; air fryer time =
// oven time × 0.8; start checking at oven time × 0.7, rounded. Times
// round to the nearest whole minute, never below 1. The multipliers
// are written as (t * 8) / 10 and (t * 7) / 10, not t * 0.8 and
// t * 0.7: 45 * 0.7 floats to 31.4999... and rounds down to 31, while
// (45 * 7) / 10 is exactly 31.5 and rounds to 32, matching the tables.
//
// Accessibility follows Modern Web Guidance: `forms` (real <form>,
// labels above inputs, hints above inputs, 48px targets),
// `validate-input-after-interaction` (:user-invalid styling, error text
// revealed only after interaction), `accessible-error-announcement`
// (aria-invalid synced with :user-invalid, one polite live region).
interface Props {
  name: string;
  typicalTempF: number;
  typicalTimeMin: number;
  foodNote?: string;
  presets: { label: string; tempF: number; timeMin: number }[];
}

const { name, typicalTempF, typicalTimeMin, foodNote, presets } =
  Astro.props;
const dish = name.toLowerCase();
const afTemp = typicalTempF - 25;
const afTime = Math.max(1, Math.round((typicalTimeMin * 8) / 10));
const checkAt = Math.max(1, Math.round((typicalTimeMin * 7) / 10));
---

<form
  id="converter-form"
  class="converter"
  aria-labelledby="converter-heading"
  novalidate
  data-dish={dish}
>
  <h2 id="converter-heading">Convert {dish}</h2>
  <div class="converter-fields">
    <div class="field">
      <label for="temp-input">Oven temperature</label>
      <span id="temp-hint" class="hint">Degrees Fahrenheit, from the recipe</span>
      <input
        type="number"
        id="temp-input"
        name="temp"
        value={typicalTempF}
        min="150"
        max="550"
        step="any"
        inputmode="decimal"
        enterkeyhint="done"
        aria-describedby="temp-hint"
        aria-invalid="false"
        data-error="temp-error"
      />
      <div id="temp-error" class="error-msg">
        <span role="img" aria-label="Error">!</span> Enter a temperature between
        150F and 550F.
      </div>
    </div>
    <div class="field">
      <label for="time-input">Oven time</label>
      <span id="time-hint" class="hint">Minutes, from the recipe</span>
      <input
        type="number"
        id="time-input"
        name="time"
        value={typicalTimeMin}
        min="1"
        max="300"
        step="any"
        inputmode="decimal"
        enterkeyhint="done"
        aria-describedby="time-hint"
        aria-invalid="false"
        data-error="time-error"
      />
      <div id="time-error" class="error-msg">
        <span role="img" aria-label="Error">!</span> Enter a time between 1 and
        300 minutes.
      </div>
    </div>
  </div>
  <button type="submit" class="convert-button">Convert</button>
  <!-- tabindex="-1" so a Convert click can move focus here (MWG
       accessibility: programmatically focusable, not in the tab order).
       No aria-hidden: a focusable element must never be aria-hidden.
       The live region still announces typing updates; the result text
       itself is not a live region, so it is never announced twice. -->
  <p class="converter-result" id="converter-result" tabindex="-1">
    {typicalTempF}F, {typicalTimeMin} min in the oven becomes {afTemp}F, {
      afTime
    } min in the air fryer. Start checking at {checkAt} min.
  </p>
  {
    foodNote && (
      <p class="hint" id="food-note">
        {foodNote}
      </p>
    )
  }
  <fieldset class="presets">
    <legend>Common oven settings</legend>
    {
      presets.map((preset) => (
        <button
          type="button"
          class="chip"
          data-temp={preset.tempF}
          data-time={preset.timeMin}
        >
          {preset.label}
        </button>
      ))
    }
  </fieldset>
</form>
<div id="converter-announcer" class="visually-hidden" aria-live="polite"></div>

<script is:inline>
  (function () {
    var form = document.getElementById('converter-form');
    if (!form) return;
    var tempInput = document.getElementById('temp-input');
    var timeInput = document.getElementById('time-input');
    var result = document.getElementById('converter-result');
    var announcer = document.getElementById('converter-announcer');
    var announceTimer = null;
    var announcedField = null;

    // One polite live region for the page carries both result updates and
    // error announcements, debounced so typing does not spam it.
    function announce(text) {
      clearTimeout(announceTimer);
      announcer.textContent = '';
      announceTimer = setTimeout(function () {
        announcer.textContent = text;
      }, 500);
    }

    function showResult(temp, time) {
      var afTemp = temp - 25;
      // (t * 8) / 10, not t * 0.8: see the note at the top of this file.
      var afTime = Math.max(1, Math.round((time * 8) / 10));
      var checkAt = Math.max(1, Math.round((time * 7) / 10));
      result.textContent =
        temp +
        'F, ' +
        time +
        ' min in the oven becomes ' +
        afTemp +
        'F, ' +
        afTime +
        ' min in the air fryer. Start checking at ' +
        checkAt +
        ' min.';
      announce(result.textContent);
    }

    function showCleared() {
      result.textContent =
        'Enter an oven temperature and time to convert.';
      announce(result.textContent);
    }

    // Brief highlight on the result after a Convert click: the answer
    // was already showing (live updates), so the click needs visible
    // feedback. Removing the class and forcing a reflow restarts the
    // animation on repeated clicks. Under prefers-reduced-motion the
    // animation never runs (CSS); the focus move still applies.
    function flashResult() {
      result.classList.remove('result-flash');
      void result.offsetWidth;
      result.classList.add('result-flash');
    }

    // Both fields feed one conversion. An empty field clears the result;
    // an out-of-range value leaves the last good result showing while
    // the inline error explains the problem.
    function convert() {
      if (tempInput.value === '' || timeInput.value === '') {
        showCleared();
        return;
      }
      var temp = parseFloat(tempInput.value);
      var time = parseFloat(timeInput.value);
      if (
        isNaN(temp) ||
        isNaN(time) ||
        temp < 150 ||
        temp > 550 ||
        time < 1 ||
        time > 300
      ) {
        return;
      }
      showResult(temp, time);
    }

    // The Convert button (and Enter) runs the conversion from the two
    // fields. No server: the submit never navigates (the form carries
    // novalidate, so native bubbles never appear and errors stay
    // inline). On an invalid field, focus moves to the first error
    // (MWG forms: submit is the final gatekeeper).
    form.addEventListener('submit', function (event) {
      event.preventDefault();
      var fields = [tempInput, timeInput];
      var firstInvalid = null;
      fields.forEach(function (el) {
        syncAria(el, true);
        if (!firstInvalid && el.getAttribute('aria-invalid') === 'true')
          firstInvalid = el;
      });
      if (firstInvalid) {
        firstInvalid.focus();
        return;
      }
      convert();
      // Visible feedback for the click: flash the result and move focus
      // to it, so the user sees and lands on the answer they just
      // asked for. Focus announces the result to screen readers, so the
      // pending live-region announcement is cleared to avoid saying it
      // twice. On error (above) there is no flash and focus stays on
      // the invalid field.
      flashResult();
      clearTimeout(announceTimer);
      announcer.textContent = '';
      result.focus();
    });

    tempInput.addEventListener('input', convert);
    timeInput.addEventListener('input', convert);

    form.querySelectorAll('.chip').forEach(function (chip) {
      chip.addEventListener('click', function () {
        tempInput.value = chip.dataset.temp;
        timeInput.value = chip.dataset.time;
        convert();
        tempInput.focus();
      });
    });

    // Keep aria-invalid in sync with the CSS :user-invalid state, and
    // announce errors through the one polite live region. Adapted from
    // the validate-input-after-interaction guide.
    function linkError(el, shown) {
      var errorId = el.dataset.error;
      if (!errorId) return;
      var ids = (el.getAttribute('aria-describedby') || '')
        .split(/\s+/)
        .filter(function (id) {
          return id && id !== errorId;
        });
      if (shown) ids.push(errorId);
      if (ids.length) el.setAttribute('aria-describedby', ids.join(' '));
      else el.removeAttribute('aria-describedby');
    }

    function spokenText(node) {
      var copy = node.cloneNode(true);
      copy.querySelectorAll('[aria-hidden="true"]').forEach(function (n) {
        n.remove();
      });
      copy
        .querySelectorAll('[role="img"][aria-label]')
        .forEach(function (n) {
          n.replaceWith(n.getAttribute('aria-label') + ': ');
        });
      return copy.textContent.replace(/\s+/g, ' ').trim();
    }

    var flagged = new WeakSet();
    var announced = new WeakSet();
    function syncAria(el, doAnnounce) {
      if (!el.matches || !el.matches('input, select, textarea')) return;
      var invalid = el.matches(':user-invalid');
      if (invalid) {
        if (doAnnounce && !announced.has(el)) {
          var error = document.getElementById(el.dataset.error);
          if (error) {
            var label = el.labels && el.labels[0]
              ? spokenText(el.labels[0]) + ': '
              : '';
            announcedField = el;
            announce(label + spokenText(error));
          }
          announced.add(el);
        }
        el.setAttribute('aria-invalid', 'true');
        linkError(el, true);
        flagged.add(el);
      } else if (
        flagged.has(el) ||
        el.getAttribute('aria-invalid') !== 'true'
      ) {
        el.setAttribute('aria-invalid', 'false');
        linkError(el, false);
        flagged.delete(el);
        announced.delete(el);
        if (announcedField === el) {
          clearTimeout(announceTimer);
          announcer.textContent = '';
        }
      }
    }

    form
      .querySelectorAll('input, select, textarea')
      .forEach(function (el) {
        syncAria(el);
      });
    form.addEventListener(
      'blur',
      function (e) {
        syncAria(e.target, true);
      },
      true,
    );
    form.addEventListener('input', function (e) {
      if (e.target.hasAttribute('aria-invalid')) syncAria(e.target);
    });
    form.addEventListener(
      'change',
      function (e) {
        syncAria(e.target, true);
      },
      true,
    );
    form.addEventListener(
      'invalid',
      function (e) {
        announced.add(e.target);
        syncAria(e.target);
      },
      true,
    );
  })();
</script>
