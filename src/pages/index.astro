---
import BaseLayout from '../layouts/BaseLayout.astro';

// The tools directory: all 61 engines from the locked taxonomy, grouped by
// category. A shipped engine is an object with a link; the rest are plain
// text until they ship.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const categories = [
  {
    name: 'Conversions & Measurements',
    engines: [
      {
        name: 'Ingredient Weight Converter',
        href: `${base}/ingredient-weight-converter/`,
      },
      {
        name: 'Volume Converter',
        href: `${base}/volume-converter/`,
      },
      'Weight Converter',
      'Oven Temperature Converter',
      'Yeast Converter',
      'Fresh-to-Dried Herb Converter',
      'Garlic Converter',
      'Oil-to-Butter Converter',
      'Dry-to-Cooked Converter',
      'Can & Jar Size Converter',
    ],
  },
  {
    name: 'Recipe Scaling & Planning',
    engines: [
      {
        name: 'Recipe Scaler',
        href: `${base}/recipe-scaler/`,
      },
      'Ingredient Substitution Finder',
      {
        name: 'Pan Size Converter',
        href: `${base}/pan-size-converter/`,
      },
      'Serving Planner',
      'Rice & Grain Cooking Calculator',
    ],
  },
  {
    name: 'Baking, Dough & Desserts',
    engines: [
      "Baker's Percentage Calculator",
      {
        name: 'Sourdough Calculator',
        href: `${base}/sourdough-calculator/`,
      },
      'Pizza Dough Calculator',
      'Bread Loaf Calculator',
      'Cake Serving Calculator',
      'Self-Rising Flour Calculator',
      'Chocolate Calculator',
      'Frosting & Icing Calculator',
      'Pancake & Waffle Batter Calculator',
      'Pasta Dough Calculator',
      'Ice Cream Base Calculator',
      'Altitude Baking Adjuster',
    ],
  },
  {
    name: 'Coffee & Tea',
    engines: [
      {
        name: 'Coffee Ratio Calculator',
        href: `${base}/coffee-ratio-calculator/`,
      },
      'Cold Brew Calculator',
      'Espresso Calculator',
      'Tea Brewing Calculator',
    ],
  },
  {
    name: 'Meat, Poultry & Roasting',
    engines: [
      'Roast Timing Calculator',
      'Turkey Cooking Time Calculator',
      'Steak Cook Time Calculator',
      'Brine Calculator',
      'Meat Temperature & Rest Finder',
      'Marinade Calculator',
      'Vegetable Roasting Time Finder',
    ],
  },
  {
    name: 'Holiday & Hosting',
    engines: ['Thanksgiving Dinner Planner', 'Gravy Calculator'],
  },
  {
    name: 'Appliance Converters & Timers',
    engines: [
      {
        name: 'Oven-to-Air-Fryer Converter',
        href: `${base}/oven-to-air-fryer-converter/`,
      },
      'Air-Fryer Cooking Time Finder',
      'Slow Cooker Converter',
      'Pressure Cooker Converter',
      'Convection Oven Converter',
      'Sous Vide Time & Temperature Calculator',
      'Deep-Fry Calculator',
    ],
  },
  {
    name: 'Food Safety & Storage',
    engines: [
      {
        name: 'Egg Boiling Calculator',
        href: `${base}/egg-boiling-calculator/`,
      },
      'Food Storage Life Finder',
      'Thawing Time Calculator',
    ],
  },
  {
    name: 'Party & Serving',
    engines: [
      'Pizza Party Calculator',
      'BBQ Party Calculator',
      'Taco Bar Calculator',
      'Party Drinks & Ice Calculator',
    ],
  },
  {
    name: 'Outdoor & Grilling',
    engines: [
      'Smoking Time Calculator',
      'Charcoal & Fuel Calculator',
      'Grilling Time Finder',
    ],
  },
  {
    name: 'Preserving & Fermenting',
    engines: [
      'Canning Time Calculator',
      'Pickling & Fermentation Brine Calculator',
      'Curing Calculator',
      'Dehydrator Time Calculator',
    ],
  },
];

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      name: 'Kitchen Tools',
      url: 'https://kitchenwayfinder.com/tools/',
      author: {
        '@type': 'Person',
        name: 'Felicity Vance',
        url: 'https://kitchenwayfinder.com/about/',
      },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Home',
          item: 'https://kitchenwayfinder.com/',
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Tools',
          item: 'https://kitchenwayfinder.com/tools/',
        },
      ],
    },
  ],
};
---

<BaseLayout
  title="Kitchen Tools"
  description="Kitchen calculators from Kitchen Wayfinder: cups to grams, oven to air fryer, recipe scaling, turkey timing, and more. The answer first, then the working."
>
  <script
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(structuredData)}
  />
  <div class="wrap">
    <h1>Kitchen tools</h1>
    <p class="lede">
      The calculators I reach for in my own kitchen — cups to grams when I am
      baking, oven to air fryer when I am converting a recipe, how long the
      turkey needs at Thanksgiving. Each one gives you the answer first, then
      shows its working.
    </p>
    <div class="category-grid">
      {
        categories.map((category) => (
          <section class="category-card">
            <h2>{category.name}</h2>
            <ul>
              {category.engines.map((engine) => (
                <li>
                  {typeof engine === 'string' ? (
                    engine
                  ) : (
                    <a href={engine.href}>{engine.name}</a>
                  )}
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </div>
</BaseLayout>
