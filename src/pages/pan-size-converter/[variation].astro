---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PanSizeConverter from '../../components/PanSizeConverter.astro';

export async function getStaticPaths() {
  const variations = await getCollection(
    'variations',
    (entry) => entry.data.engine === 'pan-size-converter',
  );
  const engines = await getCollection(
    'engines',
    (entry) => entry.data.slug === 'pan-size-converter',
  );
  const engine = engines[0];
  return variations.map((variation) => ({
    params: { variation: variation.data.slug },
    props: { variation, siblings: variations, engine },
  }));
}

const { variation, siblings, engine } = Astro.props;
const data = variation.data;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const engineUrl = `${base}/pan-size-converter/`;
const pageUrl = `${engineUrl}${data.slug}/`;
const canonicalUrl = `https://kitchenwayfinder.com${pageUrl}`;

// Calculator data for this pan pair (areas or volumes, factor, time
// rule). The table rows in the JSON were computed from the same factor
// the calculator uses, so the table and the tool can never disagree.
const calc = data.data as {
  fromPan: string;
  toPan: string;
  fromArea?: number;
  toArea?: number;
  fromCups?: number;
  toCups?: number;
  factor: number;
  basis: string;
  timeRule: string;
  defaultCups: number;
  defaultTime: number;
};
const table = data.table as {
  caption: string;
  columns: string[];
  rows: string[][];
};
const factorDisplay = parseFloat(calc.factor.toFixed(2));
const basisNote =
  calc.basis === 'volume'
    ? `Scaled by volume: ${calc.toCups} ÷ ${calc.fromCups} = ${factorDisplay}.`
    : `Scaled by area: ${calc.toArea} ÷ ${calc.fromArea} = ${factorDisplay}.`;
const timeNote =
  calc.timeRule === 'longer'
    ? 'The batter sits deeper, so expect 10 to 15 minutes longer.'
    : calc.timeRule === 'shorter'
      ? 'The batter sits shallower, so start checking 10 to 15 minutes early.'
      : 'Same batter depth, so the bake time stays the same.';

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': ['SoftwareApplication', 'WebApplication'],
      name: data.title,
      applicationCategory: 'UtilitiesApplication',
      operatingSystem: 'Web',
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      browserRequirements: 'Requires JavaScript for the live converter',
    },
    {
      '@type': 'FAQPage',
      mainEntity: data.faqs.map((faq) => ({
        '@type': 'Question',
        name: faq.question,
        acceptedAnswer: { '@type': 'Answer', text: faq.answer },
      })),
    },
    {
      '@type': 'HowTo',
      name: `How to switch from ${calc.fromPan} to ${calc.toPan}`,
      step: data.howToSteps.map((step) => ({
        '@type': 'HowToStep',
        name: step.name,
        text: step.text,
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Home',
          item: 'https://kitchenwayfinder.com/',
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Tools',
          item: 'https://kitchenwayfinder.com/tools/',
        },
        {
          '@type': 'ListItem',
          position: 3,
          name: engine.data.name,
          item: `https://kitchenwayfinder.com${engineUrl}`,
        },
        {
          '@type': 'ListItem',
          position: 4,
          name: data.name,
          item: canonicalUrl,
        },
      ],
    },
    {
      '@type': 'WebPage',
      name: data.title,
      url: canonicalUrl,
      author: {
        '@type': 'Person',
        name: 'Felicity Vance',
        url: 'https://kitchenwayfinder.com/about/',
      },
      dateModified: data.dateModified,
    },
  ],
};
---

<BaseLayout
  title={data.title}
  description={data.description}
  canonicalPath={`/pan-size-converter/${data.slug}/`}
>
  <script
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(structuredData)}
  />
  <div class="wrap tool-page">
    <nav aria-label="Breadcrumb" class="breadcrumbs">
      <ol>
        <li><a href="https://kitchenwayfinder.com/">Home</a></li>
        <li><a href={`${base}/`}>Tools</a></li>
        <li><a href={engineUrl}>{engine.data.name}</a></li>
        <li aria-current="page">{data.name}</li>
      </ol>
    </nav>

    <h1>{data.title}</h1>
    <p class="lede">{data.lede}</p>
    <p class="byline">
      By <a href="https://kitchenwayfinder.com/about/">Felicity Vance</a>
    </p>

    <PanSizeConverter
      fromPan={calc.fromPan}
      toPan={calc.toPan}
      factor={calc.factor}
      basis={calc.basis}
      timeRule={calc.timeRule}
      defaultCups={calc.defaultCups}
      defaultTime={calc.defaultTime}
      presets={data.presets}
    />

    <section aria-labelledby="table-heading">
      <h2 id="table-heading">Batter amounts</h2>
      <div
        class="table-wrapper"
        tabindex="0"
        role="region"
        aria-labelledby="table-caption"
      >
        <table>
          <caption id="table-caption">{table.caption}</caption>
          <thead>
            <tr>
              {
                table.columns.map((column) => (
                  <th scope="col">{column}</th>
                ))
              }
            </tr>
          </thead>
          <tbody>
            {
              table.rows.map((row) => (
                <tr>
                  <th scope="row">{row[0]}</th>
                  {row.slice(1).map((cell) => (
                    <td>{cell}</td>
                  ))}
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p>
        {basisNote} {timeNote}
      </p>
    </section>

    <section aria-labelledby="howto-heading">
      <h2 id="howto-heading">How to switch pans</h2>
      <ol class="steps">
        {
          data.howToSteps.map((step) => (
            <li>
              <strong>{step.name}.</strong> {step.text}
            </li>
          ))
        }
      </ol>
    </section>

    <section aria-labelledby="tutorial-heading">
      <h2 id="tutorial-heading">About this pan swap</h2>
      {data.tutorial.map((paragraph) => <p>{paragraph}</p>)}
    </section>

    <section aria-labelledby="formula-heading">
      <h2 id="formula-heading">The formula</h2>
      <p class="formula">{data.formula.text}</p>
      <dl class="formula-parts">
        {
          data.formula.parts.map((part) => (
            <div>
              <dt>{part.term}</dt>
              <dd>{part.meaning}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section aria-labelledby="examples-heading">
      <h2 id="examples-heading">Worked examples</h2>
      {
        data.examples.map((example) => (
          <div class="example">
            <h3>{example.title}</h3>
            <ol>
              {example.steps.map((step) => <li>{step}</li>)}
            </ol>
            <p class="example-result">{example.result}</p>
          </div>
        ))
      }
    </section>

    <section aria-labelledby="faq-heading">
      <h2 id="faq-heading">Questions about this pan swap</h2>
      {
        data.faqs.map((faq) => (
          <div class="faq">
            <h3>{faq.question}</h3>
            <p>{faq.answer}</p>
          </div>
        ))
      }
    </section>

    <aside class="felicity-note" aria-label="A note from Felicity">
      <p>{data.felicityNote}</p>
      <p class="felicity-signoff">
        — <a href="https://kitchenwayfinder.com/about/">Felicity</a>
      </p>
    </aside>

    <section aria-labelledby="reading-heading">
      <h2 id="reading-heading">Keep reading</h2>
      <ul>
        {
          data.links.map((link) => (
            <li>
              <a href={link.url}>{link.title}</a>
            </li>
          ))
        }
      </ul>
    </section>

    <nav aria-label="More converters" class="more-converters">
      <h2>More converters</h2>
      <ul>
        {
          siblings
            .filter((sibling) => sibling.data.slug !== data.slug)
            .map((sibling) => (
              <li>
                <a href={`${engineUrl}${sibling.data.slug}/`}>
                  {sibling.data.title}
                </a>{' '}
                — {sibling.data.summary}
              </li>
            ))
        }
      </ul>
      <p>
        <a href={engineUrl}>All {engine.data.name} converters</a>
      </p>
    </nav>
  </div>
</BaseLayout>
