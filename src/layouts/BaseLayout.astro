---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
}

const { title, description, canonicalPath = '/' } = Astro.props;
// BASE_URL is '/tools' (no trailing slash); the tools home link needs it.
const base = import.meta.env.BASE_URL;
const toolsHome = base.endsWith('/') ? base : `${base}/`;
const canonical =
  canonicalPath === '/'
    ? 'https://kitchenwayfinder.com/tools/'
    : `https://kitchenwayfinder.com/tools${canonicalPath}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | Kitchen Wayfinder</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Public+Sans:wght@400;500;600;700&family=Source+Serif+4:opsz,wght@8..60,600;8..60,700&display=swap"
      rel="stylesheet"
    />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>
    <header class="site-header">
      <div class="wrap header-inner">
        <a class="wordmark" href="https://kitchenwayfinder.com/">Kitchen Wayfinder</a>
        <nav aria-label="Primary">
          <ul>
            <li><a href="https://kitchenwayfinder.com/">Guides</a></li>
            <li><a href={toolsHome} aria-current="page">Tools</a></li>
          </ul>
        </nav>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <p>Kitchen Wayfinder — Real kitchens. Honest answers.</p>
        <p><a href="https://kitchenwayfinder.com/">Back to kitchenwayfinder.com</a></p>
      </div>
    </footer>
  </body>
</html>
